{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/waitlist.js": {
      "runtime": "nodejs18.x"
    },
    "api/[...path].js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
