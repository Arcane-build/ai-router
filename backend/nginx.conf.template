# Nginx configuration for AI Router Backend (Docker)
# This file is a template - DOMAIN_NAME will be replaced during deployment
# This file is mounted into the nginx container at /etc/nginx/conf.d/default.conf

# HTTP server - redirects to HTTPS after SSL setup
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN_NAME;

    # Allow Let's Encrypt challenges (for SSL setup)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Initially proxy to backend (change to redirect after SSL setup)
    # After SSL is configured, uncomment the redirect line below and comment out the proxy block
    location / {
        proxy_pass http://backend:3001;
        proxy_http_version 1.1;
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Buffering
        proxy_buffering off;
        proxy_request_buffering off;
    }
    
    # Uncomment this after SSL is set up to redirect HTTP to HTTPS:
    # location / {
    #     return 301 https://$host$request_uri;
    # }

    # Health check endpoint (for monitoring)
    location /nginx-health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

